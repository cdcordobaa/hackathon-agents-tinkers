# The detection gateway (meet-mobile-tap/server). 10.0.2.2 is how the Android
# emulator reaches this computer; a physical phone needs the LAN address, and
# the iOS simulator can use localhost.
#
# Port 8788 rather than the gateway's own default 8787, because the LiveKit
# demo gateway in meet-mobile-tap/agent already holds 8787. Start the session
# gateway to match:  cd meet-mobile-tap/server && PORT=8788 npm run dev
EXPO_PUBLIC_GATEWAY_URL=http://10.0.2.2:8788
