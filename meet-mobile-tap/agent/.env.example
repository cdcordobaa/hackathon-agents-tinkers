# LiveKit Cloud project -> Settings -> API keys.
# These credentials stay in this server process. Never use EXPO_PUBLIC_ names.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required for live transcription. Also supplies risk analysis if OpenAI is absent.

# Get a key at https://aistudio.google.com/apikey and check the project's quota.
GEMINI_API_KEY=

# OPENAI_API_KEY=sk-...

# Optional alternative for risk analysis; Gemini is still required for transcription.
# If both keys are set, OpenAI wins unless ANALYSIS_PROVIDER says otherwise.

# Optional overrides
# ANALYSIS_PROVIDER=gemini
# ANALYSIS_MODEL=gemini-2.5-flash
# TRANSCRIBE_MODEL=gemini-2.5-flash
# ANALYSIS_INTERVAL_MS=15000

# Local demo gateway. Use only on a trusted LAN; this is not a public auth service.
# PORT=8787
# HOST=0.0.0.0
# ALLOWED_ORIGINS=http://localhost:5173
