# Select the mobile experience. `livekit` is the default when this is omitted;
# use `session` for the session-event/CopilotKit flow from origin/main.
EXPO_PUBLIC_CALL_EXPERIENCE=livekit

# Both experiences use a public gateway URL. `localhost` works in the iOS
# Simulator; use http://10.0.2.2:8787 on Android Emulator or your computer's
# LAN address on a physical phone. Restart Metro with --clear after changes.
EXPO_PUBLIC_GATEWAY_URL=http://localhost:8787

# Optional CopilotKit runtime URL for session mode. It defaults to
# EXPO_PUBLIC_GATEWAY_URL/copilotkit when omitted.
# EXPO_PUBLIC_RUNTIME_URL=

# Session mode's legacy LiveKit panel can still use a minted room token. These
# are public, room-scoped credentials; provider URL/key/secret values stay
# only in ../agent/.env. `npm run token -- --room demo --identity phone` writes
# these two values as a fallback for that panel.
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_LIVEKIT_TOKEN=
