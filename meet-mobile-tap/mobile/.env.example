# The mobile app uses the same gateway as the browser experience. `localhost` works in the iOS
# Simulator; use http://10.0.2.2:8787 on Android Emulator or your computer's
# LAN address on a physical phone. Restart Metro with --clear after changes.
EXPO_PUBLIC_GATEWAY_URL=http://localhost:8787

# Optional. The Assistant tab is hidden unless a working CopilotKit runtime is configured.
EXPO_PUBLIC_COPILOTKIT_RUNTIME_URL=
