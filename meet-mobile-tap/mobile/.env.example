# ---- Gateway (required) ----------------------------------------------------
# `localhost` on a phone means THE PHONE, not your laptop. Use your machine's
# LAN IP for a physical device; the Simulator can use localhost.
#   iOS Simulator     http://localhost:8787
#   Android emulator  http://10.0.2.2:8787
#   Physical device   http://<your-laptop-LAN-IP>:8787
# Expo bakes EXPO_PUBLIC_ vars in at bundle time, so restart Metro with
# --clear after changing this or the app keeps the old value.
EXPO_PUBLIC_GATEWAY_URL=http://localhost:8787

# The CopilotKit runtime. Defaults to a path on the gateway. A URL, never a key.
# EXPO_PUBLIC_RUNTIME_URL=

# ---- LiveKit (only needed for the live-room rung) --------------------------
# From LiveKit Cloud → Settings → Keys. The free tier is enough for this.
# Not needed to test the UI: the gateway's replay source drives the whole
# screen with no room, no browser and no account.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# Written by `npm run token` — do not edit by hand.
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_LIVEKIT_TOKEN=
