{
  "expo": {
    "name": "Xentinela",
    "slug": "room-tap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.hackaton.xentinela",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Xentinela uses the microphone to carry your side of the call and to transcribe it.",
        "NSLocalNetworkUsageDescription": "Xentinela connects to the Xentinela demo gateway running on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.hackaton.xentinela",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "./plugins/with-demo-cleartext.js"
    ],
    "scheme": "xentinela",
    "extra": {
      "eas": {
        "projectId": "f810ecc2-8642-410d-91c5-32cb64b5ca7f"
      }
    },
    "owner": "tobyarcus"
  }
}
