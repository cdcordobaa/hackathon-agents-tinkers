# --- LiveKit room (minted by `npm run token`, or paste manually in the UI) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# What `npm run token` writes (also editable live in the app's Connect panel):
# VITE_LIVEKIT_URL=
# VITE_LIVEKIT_TOKEN=
# VITE_LIVEKIT_ROOM=demo
# VITE_LIVEKIT_IDENTITY=browser

# --- Gateway ---
VITE_GATEWAY_URL=http://localhost:8787

# --- OpenAI Realtime transcription ---
# Read ONLY by token-server/server.mjs (a separate Node process, never
# bundled by Vite) — never prefix this VITE_, or it ships in the browser.
OPENAI_API_KEY=
VITE_TRANSCRIBE_MODEL=gpt-live-transcribe
VITE_TOKEN_SERVER_URL=http://localhost:8788
TOKEN_SERVER_PORT=8788
