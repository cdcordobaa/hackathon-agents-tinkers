{
  "name": "claude-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Exposes the Claude Agent SDK over AG-UI so CopilotKit can drive it. Uses your local Claude Code login when no API key is set.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/claude-agent-sdk": "0.0.3",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@anthropic-ai/sdk": "^0.125.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0"
  }
}
