{
  "name": "two-way-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A two-way agent<->UI loop with CopilotKit v2: the agent renders components, the UI reports back.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "dev:claude": "AGENT_URL=http://localhost:8000 next dev -p 3200"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@copilotkit/react-core": "1.70.1",
    "@copilotkit/runtime": "1.70.3",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  }
}
