# Copy to .env.local, then fill in one provider key.
#   cp .env.example .env.local

MODEL_PROVIDER=openai
OPENAI_API_KEY=
# gpt-5.6-luna is ~25x cheaper than the sol default and fine for this demo.
MODEL=gpt-5.6-sol

# Alternatives (set MODEL_PROVIDER to match):
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MODEL=claude-sonnet-5
